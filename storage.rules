rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/designs/{designId}/{path=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/uploads/{uploadId} {\n      allow read, write, delete: if request.auth != null && request.auth.uid == userId;\n    }\n    match /{path=**} {
      allow read, write: if false;
    }
  }
}